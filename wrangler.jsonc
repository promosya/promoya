// Configuración para instalar tu propia copia en TU cuenta de Cloudflare (plan gratis).
// El botón "Deploy to Cloudflare" crea solo la base de datos D1 y publica todo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promoya",
  "main": "servidor/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/o/*", "/l/*", "/baja/*", "/privacidad", "/condiciones"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "promoya" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
